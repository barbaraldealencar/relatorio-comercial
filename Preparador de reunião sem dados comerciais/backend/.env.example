# Copie este arquivo para ".env" (na mesma pasta) e preencha.
# O .env NÃO deve ser compartilhado nem versionado.

# Chave de API do Amazon Bedrock (gerada no console da AWS > Bedrock > API keys).
# Chaves de curto prazo expiram em até 12 horas.
AWS_BEARER_TOKEN_BEDROCK=

# Região do Bedrock (São Paulo)
AWS_REGION=sa-east-1

# Modelo do Claude no Bedrock (perfil de inferência global). Padrão: Claude Opus 5.
# Outras opções: global.anthropic.claude-opus-5-5 (quando liberado), global.anthropic.claude-opus-4-8, global.anthropic.claude-sonnet-5-5
CLAUDE_MODEL=global.anthropic.claude-opus-5

# Profundidade da análise: low | medium | high | xhigh | max
CLAUDE_EFFORT=high
